[Unit]
Description=Start/restart Redgres Cloudflare Tunnel when the connector token file appears or changes

[Path]
# Path units do not restart an already-active Unit= service; they only start it.
# Route through a oneshot that systemctl-restarts the real connector.
PathChanged=/var/lib/redgres/secrets/cloudflared-tunnel-token
PathExists=/var/lib/redgres/secrets/cloudflared-tunnel-token
Unit=cloudflared-redgres-restart.service

[Install]
WantedBy=multi-user.target
