[Unit]
Description=Start/restart Redgres Cloudflare Tunnel when the connector token file appears or changes

[Path]
# PathExists+oneshot retriggers in a loop once the token file exists (Degraded/1033).
# Boot start is ConditionPathExists on cloudflared-redgres.service.
# PathChanged restarts only when apply rewrites the token.
PathChanged=/var/lib/redgres/secrets/cloudflared-tunnel-token
Unit=cloudflared-redgres-restart.service

[Install]
WantedBy=multi-user.target
