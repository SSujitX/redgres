# Development-only example. Production uses /etc/redgres plus credential files.
REDGRES_ENVIRONMENT=development
REDGRES_ADDRESS=127.0.0.1:8790
# Page origin for cookie/CSRF checks — not the listen address.
# Local unified dev (`npm --prefix web run dev:full`): http://127.0.0.1:8989
# Vite HMR (`npm run dev` in web/): http://127.0.0.1:5173
# Embedded UI (`npm run build` + serve): http://127.0.0.1:8790
REDGRES_BASE_URL=http://127.0.0.1:8790
REDGRES_SQLITE_PATH=./redgres.db
# Development-only frontend asset directory. `dev:full` sets this itself.
# Leave it commented: a value pointing at a missing directory fails startup.
#REDGRES_DEV_ASSET_DIR=./internal/web/dist/app
REDGRES_SESSION_TTL=12h
REDGRES_ABSOLUTE_SESSION_TTL=24h
REDGRES_COOKIE_SECURE=false
REDGRES_LOG_LEVEL=info

REDGRES_POSTGRES_HOST=127.0.0.1
REDGRES_POSTGRES_PORT=5432
REDGRES_POSTGRES_DATABASE=postgres
REDGRES_POSTGRES_USER=redgres_console
REDGRES_POSTGRES_PASSWORD_FILE=./secrets/postgres-admin-password
REDGRES_POSTGRES_SSLMODE=prefer
REDGRES_POSTGRES_PUBLIC_HOST=db.example.com
REDGRES_POSTGRES_DIRECT_PORT=5432
REDGRES_POSTGRES_POOLED_PORT=6432
REDGRES_POSTGRES_EXPECTED_MAJOR=18
REDGRES_POSTGRES_PROTECTED_DATABASES=postgres,template0,template1,database_console_vault
REDGRES_POSTGRES_PROTECTED_ROLES=postgres,database_console,onelife_pg_admin
REDGRES_LEGACY_VAULT_SECRET_FILE=./secrets/legacy-vault-secret

# Redis Ping uses a URL file, not a raw URL in this variable. Leave it commented
# unless the file exists: a missing path fails startup.
#REDGRES_REDIS_ADMIN_URL_FILE=./secrets/redis-admin-url
REDGRES_REDIS_PUBLIC_HOST=redis.example.com
REDGRES_REDIS_PUBLIC_PORT=6380
# Default false. Non-loopback redis:// requires true; loopback redis:// does not.
#REDGRES_REDIS_ALLOW_PLAINTEXT=true
# Optional identity guard (`8.2` or `8.8`). Requires REDGRES_REDIS_ADMIN_URL_FILE.
#REDGRES_REDIS_EXPECTED_SERIES=8.8

# Optional expert-tool hrefs. Empty is valid. Production requires https if set.
# Redgres never fetches these; they are returned on GET /api/v1/session only.
REDGRES_PGADMIN_URL=
REDGRES_REDISINSIGHT_URL=

REDGRES_FEATURE_POSTGRES_DROP=false
REDGRES_FEATURE_POSTGRES_TRUNCATE=false
REDGRES_FEATURE_POSTGRES_ROW_DELETE=false
